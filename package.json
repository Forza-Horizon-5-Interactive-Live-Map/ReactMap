{
  "name": "map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serveTiles": "python -m http.server 8000 --directory ./MapTiles",
    "docker Build ARM64 local": "docker build --platform linux/arm64  --file Dockerfile --tag dercraker0/react-map:dev .",
    "docker Build ARM64 & Push": "docker build --platform linux/arm64  --file Dockerfile --tag dercraker0/react-map:dev --push .",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mantine/core": "^7.17.4",
    "@mantine/hooks": "^7.17.4",
    "@microsoft/signalr": "^8.0.7",
    "@mui/material": "^7.0.2",
    "@tabler/icons-react": "^3.31.0",
    "@tiptap/extension-link": "^2.11.7",
    "@tiptap/react": "^2.11.7",
    "@tiptap/starter-kit": "^2.11.7",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.11.0",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "sass": "^1.86.3",
    "scss": "^0.2.4",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
